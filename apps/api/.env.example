# Copy to .env and fill in. Never commit .env.

# Application database. Supabase transaction pooler (port 6543).
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional. Used by Alembic only. Supabase session pooler (port 5432), which
# supports the prepared statements the migration runner expects.
# Falls back to DATABASE_URL when unset.
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional. Separate database used by pytest. Tests migrate it up and down,
# so it must never point at the deployed database.
TEST_DATABASE_URL=postgresql+psycopg://postgres.TEST_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Secret used to sign JWTs from Phase 4 onward. Generate a random value.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed browser origins. "*" is rejected at startup.
CORS_ORIGINS=http://localhost:3000

# Days a service may sit Due and unbooked before it counts as overdue.
OVERDUE_GRACE_PERIOD_DAYS=7
